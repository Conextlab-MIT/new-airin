{
  "manifest_version": 3,
  "name": "Airin Google Meet Transcriber",
  "version": "0.3.0",
  "description": "Capture Google Meet audio for an Airin live transcript.",
  "minimum_chrome_version": "116",
  "icons": { "192": "icon.png" },
  "permissions": [
    "activeTab",
    "offscreen",
    "sidePanel",
    "storage",
    "tabCapture"
  ],
  "host_permissions": ["https://meet.google.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_icon": "icon.png",
    "default_title": "Airin Meet transcription"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
